[node name="MovementParagraph" type="Label" parent="ScrollContainer/MarginContainer/VBoxContainer/CowboySection/MovementParagraphCenter" unique_id=1397254249]
custom_minimum_size = Vector2(700, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Cowboys don't have rockets, so drifting through space is all momentum - but a six-shooter packs a punch, and a good cowboy knows how to use that recoil to kick themselves in the direction they need to go."
autowrap_mode = 3

[node name="LassoParagraphCenter" type="CenterContainer" parent="ScrollContainer/MarginContainer/VBoxContainer/CowboySection" unique_id=847125361]
layout_mode = 2

[node name="LassoParagraph" type="Label" parent="ScrollContainer/MarginContainer/VBoxContainer/CowboySection/LassoParagraphCenter" unique_id=188081124]
custom_minimum_size = Vector2(700, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Lasso a ship, reel yourself in, and board it! If there's an enemy cowboy on board, you'll kick them right out into space. You can also lasso other objects, like asteroids - a good cowboy can use the lasso to slingshot themselves around space."
autowrap_mode = 3

[node name="HealthParagraphCenter" type="CenterContainer" parent="ScrollContainer/MarginContainer/VBoxContainer" unique_id=631619687]
layout_mode = 2

[node name="HealthParagraph" type="Label" parent="ScrollContainer/MarginContainer/VBoxContainer/HealthParagraphCenter" unique_id=1151325142]
custom_minimum_size = Vector2(700, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Health & Winning: while you're in your ship, you can rely on it to absorb damage - but once your ship loses all its health, your cowboy gets shot out into space! Your cowboy doesn't have much health on their own, so find another ship and don't linger out there too long - once your cowboy dies, it's game over."
autowrap_mode = 3
